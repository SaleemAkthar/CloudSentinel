    {
      "name": "Test 3- Send 100 Normal logs",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// checking to see if we've already done learning\r",
              "var completedLearning = pm.environment.get(\"learning_completed\");\r",
              "\r",
              "if (!completedLearning) {\r",
              "    // Send this request 99 more times\r",
              "    var count = pm.environment.get(\"learning_count\") || 1;\r",
              "    \r",
              "    if (count < 100) {\r",
              "        pm.environment.set(\"learning_count\", count + 1);\r",
              "        postman.setNextRequest(\"Test 3 - Complete Learning Phase\");\r",
              "    } else {\r",
              "        pm.environment.set(\"learning_completed\", \"true\");\r",
              "        pm.test(\"Learning phase complete\", function() {\r",
              "            var jsonData = pm.response.json();\r",
              "            pm.expect(jsonData.phase).to.eql(\"detection\");\r",
              "        });\r",
              "        postman.setNextRequest(null);\r",
              "    }\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
