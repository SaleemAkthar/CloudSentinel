    {
      "name": "Test 1 - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var template = `",
              "<style>",
              "    .container {",
              "        font-family: Arial, sans-serif;",
              "        padding: 20px;",
              "        max-width: 800px;",
              "        margin: 0 auto;",
              "    }",
              "    .header {",
              "        text-align: center;",
              "        margin-bottom: 20px;",
              "    }",
              "    .header h2 {",
              "        color: #333;",
              "        margin-bottom: 5px;",
              "    }",
              "    .status-badge {",
              "        display: inline-block;",
              "        padding: 5px 15px;",
              "        border-radius: 20px;",
              "        font-weight: bold;",
              "        margin: 10px 0;",
              "    }",
              "    .status-running {",
              "        background-color: #4CAF50;",
              "        color: white;",
              "    }",
              "    .learning-indicator {",
              "        background-color: #FF9800;",
              "        color: white;",
              "        padding: 5px 15px;",
              "        border-radius: 20px;",
              "        font-size: 12px;",
              "        margin-left: 10px;",
              "    }",
              "    .chart-container {",
              "        margin: 20px 0;",
              "    }",
              "    .metrics-grid {",
              "        display: grid;",
              "        grid-template-columns: repeat(2, 1fr);",
              "        gap: 15px;",
              "        margin-top: 20px;",
              "    }",
              "    .metric-card {",
              "        background: #f5f5f5;",
              "        padding: 15px;",
              "        border-radius: 8px;",
              "        text-align: center;",
              "    }",
              "    .metric-value {",
              "        font-size: 28px;",
              "        font-weight: bold;",
              "        color: #2196F3;",
              "    }",
              "    .metric-label {",
              "        font-size: 12px;",
              "        color: #666;",
              "        margin-top: 5px;",
              "    }",
              "    .timestamp {",
              "        text-align: center;",
              "        color: #999;",
              "        font-size: 11px;",
              "        margin-top: 20px;",
              "    }",
              "</style>",
              "",
              "<div class=\"container\">",
              "    <div class=\"header\">",
              "        <h2>Cloud Sentinel Detector Statistics</h2>",
              "        <span class=\"status-badge status-running\">{{status}}</span>",
              "        {{#if learningPhase}}",
              "        <span class=\"learning-indicator\">🔄 Learning Phase Active</span>",
              "        {{/if}}",
              "    </div>",
              "    ",
              "    <div class=\"chart-container\">",
              "        <canvas id=\"metricsChart\" height=\"200\"></canvas>",
              "    </div>",
              "    ",
              "    <div class=\"metrics-grid\">",
              "        <div class=\"metric-card\">",
              "            <div class=\"metric-value\">{{requestsSeen}}</div>",
              "            <div class=\"metric-label\">Requests Seen</div>",
              "        </div>",
              "        <div class=\"metric-card\">",
              "            <div class=\"metric-value\">{{anomaliesDetected}}</div>",
              "            <div class=\"metric-label\">Anomalies Detected</div>",
              "        </div>",
              "        <div class=\"metric-card\">",
              "            <div class=\"metric-value\">{{learningProgress}}%</div>",
              "            <div class=\"metric-label\">Learning Progress</div>",
              "        </div>",
              "        <div class=\"metric-card\">",
              "            <div class=\"metric-value\">{{meanDuration}}</div>",
              "            <div class=\"metric-label\">Mean Duration (ms)</div>",
              "        </div>",
              "    </div>",
              "    ",
              "    <div class=\"timestamp\">Last updated: {{timestamp}}</div>",
              "</div>",
              "",
              "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js\"></script>",
              "<script>",
              "    pm.getData(function (err, value) {",
              "        var ctx = document.getElementById(\"metricsChart\");",
              "        new Chart(ctx, {",
              "            type: \"bar\",",
              "            data: {",
              "                labels: [\"Requests Seen\", \"Anomalies Detected\", \"Learning Progress (%)\"],",
              "                datasets: [{",
              "                    label: \"Metrics\",",
              "                    data: [value.requestsSeen, value.anomaliesDetected, value.learningProgress],",
              "                    backgroundColor: [\"#2196F3\", \"#f44336\", \"#FF9800\"]",
              "                }]",
              "            },",
              "            options: {",
              "                legend: { display: false },",
              "                title: { display: true, text: \"Detector Metrics Overview\" },",
              "                scales: {",
              "                    yAxes: [{ ticks: { beginAtZero: true } }]",
              "                }",
              "            }",
              "        });",
              "    });",
              "</script>",
              "`;",
              "",
              "function constructVisualizerPayload() {",
              "    var response = pm.response.json();",
              "    var stats = response.detector_stats;",
              "    return {",
              "        status: response.status,",
              "        learningPhase: stats.learning_phase,",
              "        requestsSeen: stats.requests_seen,",
              "        anomaliesDetected: stats.anomalies_detected,",
              "        learningProgress: stats.learning_progress,",
              "        meanDuration: stats.baseline.duration.mean.toFixed(2),",
              "        timestamp: response.timestamp",
              "    };",
              "}",
              "",
              "pm.visualizer.set(template, constructVisualizerPayload());",
              "",
              "// Tests",
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"API is running\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"running\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
